# URL Koneksi PostgreSQL Supabase
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Contoh: postgresql://postgres:mypassword@db.supabase.co:5432/postgres
#
# Hapus tanda pagar (#) pada baris DATABASE_URL di bawah ini dan isi dengan URL database Anda 
# jika ingin menghubungkan proyek ke Supabase PostgreSQL secara lokal:
DATABASE_URL=postgresql://postgres.hyuikhoedzeoitiumbvh:Nekopo!101001010100@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# API Key DeepSeek (jika digunakan)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Flask Secret Key
SECRET_KEY=some-random-secret-key-for-session-123
